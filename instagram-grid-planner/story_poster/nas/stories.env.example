# Скопіювати в /volume1/docker/Stories/stories.env і заповнити (без крапки на початку імені). Нікому не показувати.
BUFFER_API_KEY=
BUFFER_CHANNEL_ID=6aecd2e0e29c69a171743578
CLOUDINARY_CLOUD_NAME=fqhakrk8
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# шляхи всередині контейнера, не змінювати
STORIES_DIR=/data/stories
TIMEZONE=Europe/Kyiv
# час щоденної історії за київським часом і скільки днів тримати в черзі
POST_TIME=12:00
DAYS_AHEAD=7
PER_DAY=1

# пароль для веб-інтерфейсу (логін будь-який). Якщо порожній, доступ без пароля, тільки домашня мережа
UI_PASSWORD=
UI_PORT=8095
